; Initial mobile profile. Later game settings are kept in the writable overlay.
_preset Minimum
vid_mode 1280x720
vid_fullscreen on
rs_v_sync on
texture_lod 2
unbindall
bind forward kW
bind back kS
bind lstrafe kA
bind rstrafe kD
bind accel kLSHIFT
bind sprint_toggle kX
bind crouch kLCONTROL
bind jump kSPACE
bind use kF
bind wpn_reload kR
bind wpn_fire mouse1
bind wpn_zoom mouse2
bind wpn_next kY
bind wpn_1 k1
bind wpn_6 k6
bind inventory kI
bind active_jobs kP
bind torch kL
bind show_detector kO
bind llookout kQ
bind rlookout kE
bind quick_use_1 kF1
bind quick_use_2 kF2
bind quit kESCAPE
bind up kUP
bind down kDOWN
bind left kLEFT
bind right kRIGHT
slot_0 medkit
slot_1 bandage
